# ─────────────────────────────────────────────────────────────
# MyTime — variables de entorno de ejemplo.
# Copia este archivo a `.env` y ajusta los valores. `.env` está en .gitignore.
# NUNCA pongas aquí credenciales reales: este archivo sí se versiona.
# ─────────────────────────────────────────────────────────────

# Base de datos PostgreSQL (`docker compose up -d` levanta una en 127.0.0.1:5544)
DATABASE_URL="postgresql://mytime:mytime_local_dev@127.0.0.1:5544/mytime?schema=public"
# Conexión directa para migraciones (en Neon: la URL sin "-pooler"). En local, la misma.
DIRECT_URL="postgresql://mytime:mytime_local_dev@127.0.0.1:5544/mytime?schema=public"

# Base de datos para pruebas de integración y E2E (esquema separado)
TEST_DATABASE_URL="postgresql://mytime:mytime_local_dev@127.0.0.1:5544/mytime?schema=test"

# Zona horaria usada para decidir qué día es "hoy".
# Las fechas de calendario se guardan como YYYY-MM-DD, sin hora.
MYTIME_TIMEZONE="Europe/Madrid"

# Hosts desde los que se acepta tráfico (protección frente a DNS rebinding).
# Por defecto solo localhost. Lista separada por comas.
MYTIME_ALLOWED_HOSTS="localhost,127.0.0.1"

# ── Integración Jira ─────────────────────────────────────────
# disabled → no se hace ninguna llamada (valor por defecto)
# mock     → adaptador simulado con datos ficticios, sin red
# live     → adaptador HTTP real; requiere autorización de la empresa
JIRA_MODE="disabled"

# URL base de tu instancia (sin barra final). No se codifica en el código.
JIRA_BASE_URL=""

# Mecanismo de autenticación aprobado por la empresa: pat | oauth2_bearer
JIRA_AUTH_METHOD="pat"

# Token emitido por un mecanismo autorizado (PAT o token OAuth 2.0).
# Solo se lee en el servidor; nunca se envía al navegador ni se escribe en logs.
JIRA_TOKEN=""

# Ruta al archivo de mapeo de campos (copia config/jira-mapping.example.json)
JIRA_MAPPING_FILE="config/jira-mapping.json"

# Escritura de imputaciones de horas (worklogs) en Jira.
# Desactivado por defecto: la integración inicial es SOLO LECTURA.
JIRA_ENABLE_WORKLOG_WRITE="false"

# Tiempo máximo por petición a Jira, en milisegundos
JIRA_TIMEOUT_MS="15000"

# ── Acceso (obligatorio si la app se publica fuera de tu equipo) ──
# Sin estas dos variables la app solo responde en localhost.
MYTIME_PASSWORD=""
# Al menos 32 caracteres aleatorios (p. ej. `npm run push:keys` genera uno como CRON_SECRET)
MYTIME_SESSION_SECRET=""

# ── Avisos al móvil (Web Push) ───────────────────────────────
# Genera los valores con: npm run push:keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@example.com"
# Secreto que debe enviar el programador diario a /api/cron/reminders
CRON_SECRET=""
